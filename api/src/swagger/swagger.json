{
  "openapi": "3.0.0",
  "info": {
    "title": "Hisabi API",
    "description": "Islamic daily tracker API — prayers, Quran, dhikr, fasting, streaks, groups and more.",
    "version": "2.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Development server"
    }
  ],
  "tags": [
    { "name": "Auth",             "description": "Authentication" },
    { "name": "User",             "description": "User profile & settings" },
    { "name": "Activity",         "description": "Daily activity progress & calendar" },
    { "name": "Prayers",          "description": "Fardh & sunnah prayer tracking" },
    { "name": "Dhikr",            "description": "Dhikr (remembrance) tracking" },
    { "name": "Duas",             "description": "Dua memorization" },
    { "name": "Fasting",          "description": "Fasting day tracking" },
    { "name": "Quran",            "description": "Quran reading & memorization" },
    { "name": "Periods",          "description": "Menstrual cycle tracking (female users only)" },
    { "name": "Streaks",          "description": "Activity streak tracking" },
    { "name": "Goals",            "description": "Goal settings & memorization goals" },
    { "name": "Groups",           "description": "Group management" },
    { "name": "Group Activities", "description": "Group activity tracking" },
    { "name": "Admin",            "description": "Admin panel operations" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {}
}
